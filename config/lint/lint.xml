<!--
  Cabin Android Lint config. Rationale: docs/quality.md.
  Existing issues: <module>/lint-baseline.xml (only new issues fail).
-->
<lint>
    <!-- Glanceable + localizable: user-visible text must be a resource. -->
    <issue id="HardcodedText" severity="error" />
    <issue id="SetTextI18n" severity="error" />
    <!-- Accessibility is a safety requirement in a car. -->
    <issue id="ContentDescription" severity="error" />
    <issue id="ClickableViewAccessibility" severity="error" />
    <issue id="KeyboardInaccessibleWidget" severity="error" />
    <issue id="LabelFor" severity="error" />
    <!-- API correctness across the AAOS versions we support (minSdk 29). -->
    <issue id="NewApi" severity="fatal" />
    <issue id="InlinedApi" severity="error" />
    <issue id="UnusedResources" severity="warning" />
    <!-- Translations arrive later through AOSP's localization pipeline. -->
    <issue id="MissingTranslation" severity="ignore" />
    <!-- Version checks against the AGP/Compose we pin are handled by Renovate-style updates, not lint. -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
</lint>
