// CabinViews — Theme Kit + System/Status bars + Button/IconButton/ListItem (Alpha).
// Same sources as the Gradle module (:cabin-views).
// See docs/adoption/build-tree.md · ADR 0001 / 0002 · docs/api-contracts.md.
//
// Thin deps: tokens + compliance (+ approved AndroidX support libs only).
// Must NOT depend on CabinCompose. Primary SystemUI / build-tree surface.

android_library {
    name: "CabinViews",
    defaults: ["CabinAndroidLibraryDefaults"],
    visibility: ["//visibility:public"],
    srcs: ["src/main/java/**/*.kt"],
    resource_dirs: ["src/main/res"],
    manifest: "src/main/AndroidManifest.xml",
    static_libs: [
        "CabinTokens",
        "CabinCompliance",
        // Mirrors Gradle implementation(androidx.annotation).
        // Soong name is stable on modern AndroidX trees; adjust if the host
        // branch still uses a legacy alias.
        "androidx.annotation_annotation",
    ],
}
