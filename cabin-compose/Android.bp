// CabinCompose — Experimental Theme + System/Status bar parity.
// Same sources as the Gradle module (:cabin-compose).
// See docs/adoption/build-tree.md · ADR 0002 · docs/platforms/compose.md.
//
// Opt-in for Compose-capable platform apps / Gradle-parity only.
// Do NOT add CabinCompose to SystemUI static_libs (Views-first).
// Must NOT depend on CabinViews.

android_library {
    name: "CabinCompose",
    defaults: ["CabinAndroidLibraryDefaults"],
    visibility: ["//visibility:public"],
    srcs: ["src/main/java/**/*.kt"],
    resource_dirs: ["src/main/res"],
    manifest: "src/main/AndroidManifest.xml",
    kotlin_plugins: ["kotlin-compose-compiler-plugin"],
    static_libs: [
        "CabinTokens",
        "CabinCompliance",
        "CabinFoundation",
        "androidx.annotation_annotation",
        // AOSP prebuilts (prebuilts/sdk/current/androidx). Material 3 is part
        // of the public theme API (ADR 0006).
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.foundation_foundation",
        "androidx.compose.material3_material3",
    ],
}
