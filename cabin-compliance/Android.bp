// CabinCompliance — Restriction Engine + Signal (Alpha).
// Same sources as the Gradle module (:cabin-compliance).
// See docs/adoption/build-tree.md · ADR 0001 / 0004 · docs/api-contracts.md.
//
// Hard rule: no Compose UI or View widgets. Tokens only.

android_library {
    name: "CabinCompliance",
    defaults: ["CabinAndroidLibraryDefaults"],
    visibility: ["//visibility:public"],
    srcs: ["src/main/java/**/*.kt"],
    manifest: "src/main/AndroidManifest.xml",
    static_libs: [
        "CabinTokens",
    ],
}
