// CabinScreens — Experimental reference screens (Home, Media, Climate).
// Same sources as the Gradle module (:cabin-screens). ADR 0006.
//
// Apps only. NEVER add CabinScreens to SystemUI static_libs (Views-first).
// Must NOT depend on CabinViews.

android_library {
    name: "CabinScreens",
    defaults: ["CabinAndroidLibraryDefaults"],
    visibility: ["//visibility:public"],
    srcs: ["src/main/java/**/*.kt"],
    resource_dirs: ["src/main/res"],
    manifest: "AndroidManifest.xml",
    kotlin_plugins: ["kotlin-compose-compiler-plugin"],
    static_libs: [
        "CabinCompose",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.foundation_foundation",
        "androidx.compose.material3_material3",
    ],
}
