// CabinTokens — design tokens only (Alpha).
// Same sources as the Gradle module (:cabin-tokens).
// See docs/adoption/build-tree.md · ADR 0001 · docs/api-contracts.md.
//
// Hard rule: no Compose, Views widgets, AppCompat, or Material deps.

android_library {
    name: "CabinTokens",
    defaults: ["CabinAndroidLibraryDefaults"],
    visibility: ["//visibility:public"],
    srcs: ["src/main/java/**/*.kt"],
    resource_dirs: ["src/main/res"],
    manifest: "src/main/AndroidManifest.xml",
}
